<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_kuormat_view_choose_delivery_carrier_inherit" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.form.inherit.kuormat</field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_price']" position="before">
                <field name="wb_kuormat_number_of_items" invisible="delivery_type != 'wb_kuormat'"/>
              </xpath>
              <xpath expr="//button[@name='update_price']" position="before">
                <field name="wb_kuormat_carrier" invisible="delivery_type != 'wb_kuormat' or not wb_kuormat_carrier" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
